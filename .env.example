# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# Airtable personal access token. Required scopes:
#   data.records:read, data.records:write, schema.bases:read, schema.bases:write
# and access to the WEP base.
AIRTABLE_TOKEN=

# Airtable base ID (starts with "app")
AIRTABLE_BASE_ID=appBTvrLNv8i0QLkX

# Optional: the table that stores registrations. Use the table ID (starts with "tbl")
# so renaming the table in Airtable does not break the form. Defaults to the "WEP Official Launch" table.
AIRTABLE_TABLE_ID=

# Password for the results dashboard at /dashboard
DASHBOARD_PASSWORD=

# Optional: a second password that opens only the check-in desk at /checkin, for registration-desk
# volunteers. It can verify tickets and mark attendance but cannot see the dashboard, contact details
# or exports. Without it, the check-in desk opens with DASHBOARD_PASSWORD.
CHECKIN_PASSWORD=

# Optional: random string used to sign dashboard sessions (e.g. 32+ random characters).
# If omitted, one is derived from the password and token.
SESSION_SECRET=

# Optional: email each barangay's focal person a confirmation (with every attendee's QR ticket) right
# after they register; the barangay's own email address, if given, gets a copy.
# Gmail is the default. SMTP_USER = the Gmail address the emails come from (ideally a WEP/event account).
# SMTP_PASS = an "App password" for that account, NOT its normal password: turn on 2-Step Verification,
# then create one at https://myaccount.google.com/apppasswords (16 letters; spaces don't matter).
# Gmail sends up to about 500 emails a day. Without these two, registration still works, minus the email.
SMTP_USER=
SMTP_PASS=

# Optional, only for a provider other than Gmail (Outlook, Brevo, Resend, a government mail server):
SMTP_HOST=
SMTP_PORT=
# The sender shown to barangays, e.g. "MWSS RO Water Efficiency Program <wep.mwssro@gmail.com>".
# Needed only when SMTP_USER is not an email address (e.g. Resend, whose login is "resend").
EMAIL_FROM=
# Where replies go, if not to the sending address.
EMAIL_REPLY_TO=
